# Copia este archivo a env_vars/zabbix-server.env (no se commitea, ver .gitignore) y
# descomenta lo que necesites. Se carga en el contenedor zabbix-server como env_file
# opcional (docker-compose.yml, "required: false") — si no existe, el stack funciona igual.
#
# Estas son variables NATIVAS de la imagen zabbix/zabbix-server-mysql (no hace falta tocar
# zabbix_server.conf a mano ni reconstruir la imagen). Verificadas contra el script real de
# entrypoint de zabbix/zabbix-docker rama 7.0
# (templates/entrypoints/lib/server-config.sh). Los tuning más comunes (StartPollers,
# StartTrappers, cache sizes, etc.) ya están cableados directamente en el .env raíz del repo
# — pon esos ahí, no aquí (si los pones aquí no tendrán efecto: el bloque "environment:" del
# compose tiene prioridad sobre este env_file). Esto es para todo lo demás.
#
# Referencia completa de directivas: https://www.zabbix.com/documentation/7.0/en/manual/appendix/config/zabbix_server

# --- Más tipos de pollers/workers (menos comunes que los ya cableados en .env) ---
#ZBX_STARTIPMIPOLLERS=0
#ZBX_STARTHISTORYPOLLERS=5
#ZBX_STARTHTTPAGENTPOLLERS=1
#ZBX_STARTODBCPOLLERS=1
#ZBX_STARTSNMPPOLLERS=1
#ZBX_STARTCONNECTORS=0
#ZBX_STARTAGENTPOLLERS=0
#ZBX_STARTLLDPROCESSORS=2
#ZBX_STARTBROWSERPOLLERS=0
#ZBX_MAXCONCURRENTCHECKSPERPOLLER=1000

# --- Caches adicionales ---
#ZBX_CACHEUPDATEFREQUENCY=60
#ZBX_TRENDFUNCTIONCACHESIZE=4M

# --- Housekeeping ---
#ZBX_MAXHOUSEKEEPERDELETE=5000
#ZBX_PROBLEMHOUSEKEEPINGFREQUENCY=1h

# --- Timeouts/reachability ---
#ZBX_TRAPPERTIMEOUT=300
#ZBX_UNREACHABLEPERIOD=45
#ZBX_UNAVAILABLEDELAY=60
#ZBX_UNREACHABLEDELAY=15

# --- Export de eventos/historial a NDJSON (./data/zabbix/export) ---
#ZBX_EXPORTFILESIZE=1G
#ZBX_EXPORTTYPE=events,history,trends

# --- Global scripts / software update check / SMS ---
#ZBX_ENABLEGLOBALSCRIPTS=true
#ZBX_ALLOWSOFTWAREUPDATECHECK=1
#ZBX_SMSDEVICES=/dev/ttyUSB0

# --- Zabbix report writer (necesita el contenedor zabbix-web-service, no incluido aquí) ---
#ZBX_STARTREPORTWRITERS=0
#ZBX_WEBSERVICEURL=http://zabbix-web-service:10053/report

# --- Elasticsearch para historial (no incluido en este stack por defecto) ---
#ZBX_HISTORYSTORAGEURL=http://elasticsearch:9200
#ZBX_HISTORYSTORAGETYPES=uint,dbl,str,log,text
#ZBX_HISTORYSTORAGEDATEINDEX=0

# --- Estadísticas remotas (zabbix_server --runtime-control) ---
#ZBX_STATSALLOWEDIP=127.0.0.1

# --- Java Gateway (no incluido en este stack por defecto) ---
#ZBX_JAVAGATEWAY_ENABLE=true
#ZBX_JAVAGATEWAY=zabbix-java-gateway
#ZBX_JAVAGATEWAYPORT=10052
#ZBX_STARTJAVAPOLLERS=5

# --- VMware (no usado si no monitorizas vCenter/ESXi) ---
#ZBX_STARTVMWARECOLLECTORS=0
#ZBX_VMWAREFREQUENCY=60
#ZBX_VMWAREPERFFREQUENCY=60
#ZBX_VMWARECACHESIZE=8M
#ZBX_VMWARETIMEOUT=10

# --- SNMP traps (necesita el contenedor zabbix-snmptraps, no incluido aquí) ---
#ZBX_ENABLE_SNMP_TRAPS=true

# --- Browser monitoring (necesita WebDriver/Selenium, no incluido aquí) ---
#ZBX_WEBDRIVERURL=http://selenium-hub:4444/wd/hub

# --- Alta disponibilidad (varios zabbix-server compartiendo la misma BD) ---
#ZBX_HANODENAME=zabbix-server-1
#ZBX_NODEADDRESS=zabbix-server-1
#ZBX_NODEADDRESSPORT=10051

# --- Base de datos: soportar versiones de MySQL no oficialmente certificadas ---
#ZBX_ALLOWUNSUPPORTEDDBVERSIONS=true
#ZBX_FPINGLOCATION=/usr/sbin/fping
#ZBX_LOGSLOWQUERIES=3000

# --- TLS entre zabbix-server y MySQL ---
#ZBX_DBTLSCONNECT=verify_full
#ZBX_DBTLSCAFILE=/var/lib/zabbix/ssl/ssl_ca/ca.crt
#ZBX_DBTLSCERTFILE=/var/lib/zabbix/ssl/certs/client.crt
#ZBX_DBTLSKEYFILE=/var/lib/zabbix/ssl/keys/client.key

# --- TLS entre zabbix-server y agentes/proxies (PSK o certificados) ---
#ZBX_TLSCAFILE=/var/lib/zabbix/enc/ca.crt
#ZBX_TLSCERTFILE=/var/lib/zabbix/enc/server.crt
#ZBX_TLSKEYFILE=/var/lib/zabbix/enc/server.key

# --- HashiCorp Vault para credenciales de BD (alternativa a MYSQL_PASSWORD en claro) ---
#ZBX_VAULT=HashiCorp
#ZBX_VAULTURL=https://vault:8200
#ZBX_VAULTPREFIX=secret/zabbix
#ZBX_VAULTDBPATH=database/creds/zabbix
