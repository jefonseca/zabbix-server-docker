# Copia este archivo a env_vars/zabbix-agent2.env (no se commitea, ver .gitignore) y
# descomenta lo que necesites. Se carga en el contenedor zabbix-agent2 como env_file
# opcional (docker-compose.yml, "required: false") — si no existe, el stack funciona igual.
#
# Variables NATIVAS de la imagen zabbix/zabbix-agent2. Verificadas contra el script real de
# entrypoint de zabbix/zabbix-docker rama 7.0 (templates/entrypoints/agent2.sh). Lo más común
# (ZBX_REFRESHACTIVECHECKS, ZBX_BUFFERSIZE, ZBX_TIMEOUT, ZBX_UNSAFEUSERPARAMETERS,
# ZBX_DEBUGLEVEL) ya está cableado en el .env raíz del repo — ponlo ahí, no aquí, no tendría
# efecto (el "environment:" del compose tiene prioridad sobre este env_file). Esto es para
# todo lo demás.

# --- Buffer / checks activos ---
#ZBX_ENABLEPERSISTENTBUFFER=true
#ZBX_PERSISTENTBUFFERPERIOD=1h
#ZBX_FORCEACTIVECHECKSONSTART=true
#ZBX_HEARTBEAT_FREQUENCY=60

# --- Checks pasivos (el zabbix-server los inicia contra el agente) ---
#ZBX_PASSIVESERVERS=zabbix-server
#ZBX_PASSIVE_ALLOW=true
#ZBX_ACTIVESERVERS=zabbix-server:10051
#ZBX_ACTIVE_ALLOW=true

# --- Identificación del host ante Zabbix (alternativa a ZBX_HOSTNAME fijo) ---
#ZBX_HOSTNAMEITEM=system.hostname
#ZBX_HOSTINTERFACE=zabbix-agent2
#ZBX_HOSTINTERFACEITEM=
#ZBX_METADATA=
#ZBX_METADATAITEM=

# --- Red / status port ---
#ZBX_SOURCEIP=
#ZBX_LISTENIP=0.0.0.0
#ZBX_LISTENPORT=10050
#ZBX_ENABLESTATUSPORT=false

# --- Logging / plugins ---
#ZBX_LOGREMOTECOMMANDS=false
#ZBX_MAXLINESPERSECOND=20
#ZBX_PLUGINTIMEOUT=3

# --- Restringir qué keys puede ejecutar el agente ---
#ZBX_DENYKEY=system.run[*]
#ZBX_ALLOWKEY=vfs.file.contents[/var/log/*.log]

# --- TLS entre el agente y zabbix-server (PSK o certificados) ---
# Nota: zabbix-agent2 no monta ningún volumen por defecto en docker-compose.yml. Para usar
# estas rutas primero añade en docker-compose.yml (o en un override) algo como:
#   volumes:
#     - ./data/zabbix/agent-enc:/var/lib/zabbix/enc:ro
#ZBX_TLSCONNECT=psk
#ZBX_TLSACCEPT=psk
#ZBX_TLSPSKIDENTITY=zabbix-agent2
#ZBX_TLSPSKFILE=/var/lib/zabbix/enc/agent.psk
#ZBX_TLSCAFILE=/var/lib/zabbix/enc/ca.crt
#ZBX_TLSCERTFILE=/var/lib/zabbix/enc/agent.crt
#ZBX_TLSKEYFILE=/var/lib/zabbix/enc/agent.key
#ZBX_TLSSERVERCERTISSUER=
#ZBX_TLSSERVERCERTSUBJECT=
