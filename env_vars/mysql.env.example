# Copia este archivo a env_vars/mysql.env (no se commitea, ver .gitignore) y descomenta lo
# que necesites. Se carga en el contenedor mysql-server como env_file opcional
# (docker-compose.yml, "required: false") — si no existe, el stack funciona igual.
#
# Variables nativas de la imagen oficial "mysql" (no específicas de Zabbix). Referencia:
# https://hub.docker.com/_/mysql

#MYSQL_INITDB_SKIP_TZINFO=1
#MYSQL_ONETIME_PASSWORD=false
#MYSQL_RANDOM_ROOT_PASSWORD=false
