# Copia este archivo a env_vars/zabbix-web.env (no se commitea, ver .gitignore) y
# descomenta lo que necesites. Se carga en el contenedor zabbix-web como env_file opcional
# (docker-compose.yml, "required: false") — si no existe, el stack funciona igual.
#
# Variables NATIVAS de la imagen zabbix/zabbix-web-nginx-mysql. Verificadas contra el script
# real de entrypoint de zabbix/zabbix-docker rama 7.0 (templates/entrypoints/lib/php.sh y el
# entrypoint de web-nginx-mysql). El pool de PHP-FPM (PHP_FPM_PM_MAX_CHILDREN y compañía) ya
# está cableado en el .env raíz del repo — ponlo ahí, no aquí, no tendría efecto (el
# "environment:" del compose tiene prioridad sobre este env_file). Esto es para todo lo demás.

# --- php.ini (límites de ejecución/subida de archivos) ---
#ZBX_MAXEXECUTIONTIME=600
#ZBX_MEMORYLIMIT=128M
#ZBX_POSTMAXSIZE=16M
#ZBX_UPLOADMAXFILESIZE=2M
#ZBX_MAXINPUTTIME=300

# --- Restringir acceso al frontend por IP (además/en vez del firewall del VPS) ---
#ZBX_DENY_GUI_ACCESS=true
#ZBX_GUI_ACCESS_IP_RANGE=172.28.55.0/24,203.0.113.0/24
#ZBX_GUI_WARNING_MSG="Acceso restringido"

# --- Mostrar/ocultar info de versión de PHP/nginx en headers ---
#EXPOSE_WEB_SERVER_INFO=false

# --- TLS entre el frontend y MySQL ---
#ZBX_DB_ENCRYPTION=true
#ZBX_DB_VERIFY_HOST=true
#ZBX_DB_KEY_FILE=/var/lib/zabbix/ssl/keys/client.key
#ZBX_DB_CERT_FILE=/var/lib/zabbix/ssl/certs/client.crt
#ZBX_DB_CA_FILE=/var/lib/zabbix/ssl/ssl_ca/ca.crt

# --- Single Sign-On (SAML) ---
#ZBX_SSO_SETTINGS=...
#ZBX_SSO_SP_KEY=/var/lib/zabbix/ssl/keys/sp.key
#ZBX_SSO_SP_CERT=/var/lib/zabbix/ssl/certs/sp.crt
#ZBX_SSO_IDP_CERT=/var/lib/zabbix/ssl/certs/idp.crt
#ZBX_ALLOW_HTTP_AUTH=false

# --- HashiCorp Vault para credenciales de BD (alternativa a MYSQL_PASSWORD en claro) ---
#ZBX_VAULT=HashiCorp
#ZBX_VAULTURL=https://vault:8200
#ZBX_VAULTPREFIX=secret/zabbix
#ZBX_VAULTDBPATH=database/creds/zabbix
#VAULT_TOKEN=...

# --- Elasticsearch para historial (no incluido en este stack por defecto) ---
#ZBX_HISTORYSTORAGEURL=http://elasticsearch:9200
#ZBX_HISTORYSTORAGETYPES=uint,dbl,str,log,text
