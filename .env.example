# Copia este archivo a .env y ajusta los valores antes de "docker compose up -d".
# .env NO se versiona (ver .gitignore) — contiene contraseñas.
#
# Los valores por defecto de este archivo están pensados para un VPS DEDICADO de 2 GB de RAM
# (p.ej. Linode 2 GB) — es decir, este stack es lo único que corre en la máquina, así que los
# límites usan ~83% de la RAM total (~1.7 GB) y dejan sólo lo necesario para el kernel + Docker
# (~350 MB), no "la mitad". Para 4 GB u 8 GB, ver la tabla de sizing en el README (sección
# "Sizing de memoria") — son sólo un puñado de estas mismas variables, no hace falta tocar el
# compose.

# --- General ---
TZ=Europe/Madrid
# Tag de imagen para zabbix-server, zabbix-web y zabbix-agent2. "alpine-7.0-latest" sigue
# la última imagen dentro de la rama 7.0 LTS; para fijar una versión exacta y reproducible
# usa algo como "alpine-7.0.10".
ZBX_VERSION=alpine-7.0-latest
COMPOSE_PROJECT_NAME=zabbix

# --- MySQL ---
MYSQL_VERSION=8.0
# Contraseña root de MySQL. Se usa en el PRIMER arranque para que zabbix-server cree la
# base de datos/usuario y cargue el schema inicial. Después queda disponible para tareas
# administrativas dentro del contenedor (p.ej. crear usuarios de monitorización adicionales
# sin exponer el puerto 3306 al exterior): docker compose exec mysql-server mysql -uroot -p
# No la borres del .env tras el primer arranque por este segundo uso.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix
MYSQL_PASSWORD=changeme-zabbix
# Tamaño del innodb buffer pool (por defecto MySQL usa sólo 128M, insuficiente para Zabbix).
# Es la variable de mayor impacto en el rendimiento real (menos I/O a disco en el historial),
# por eso se lleva la mayor parte del presupuesto de RAM. Sube a 1G/2G en VPS de 4/8 GB.
MYSQL_INNODB_BUFFER_POOL_SIZE=512M
MYSQL_MEM_LIMIT=896m
# Contraseña del usuario "zbx_monitor", creado automáticamente en el primer arranque
# (ver mysql-init/01-create-zbx-monitor-user.sh) para la plantilla nativa
# "MySQL by Zabbix agent 2" del zabbix-agent2 incluido en este stack.
MYSQL_MONITOR_PASSWORD=changeme-monitor

# --- Zabbix server ---
# Puerto publicado al host para el trapper (10051), usado por agentes/proxies externos
# a este Docker (no hace falta para el zabbix-agent2 incluido, que va por red interna).
ZABBIX_SERVER_PORT=10051
ZABBIX_SERVER_MEM_LIMIT=320m

# --- Web (nginx + PHP-FPM en un único contenedor) ---
# Publicados directo en el host. Internamente el contenedor siempre escucha en 8080/8443
# (fijo por la imagen), sólo el lado host es configurable aquí.
ZABBIX_WEB_HTTP_PORT=80
ZABBIX_WEB_HTTPS_PORT=443
ZABBIX_WEB_MEM_LIMIT=384m

# --- PHP-FPM (el límite que hay que vigilar de cerca en cualquier VPS) ---
# El pool de PHP-FPM es, con diferencia, el mayor riesgo de consumo de RAM del stack: el
# default de la imagen es pm.max_children=50, y cada child ronda 30-50 MB — 50 children
# pueden llegar a ~2 GB ellos solos. Los valores de abajo dan hasta 8 children concurrentes
# (suficiente para 1-3 admins usando el frontend a la vez) dentro de ZABBIX_WEB_MEM_LIMIT; en
# 4/8 GB puedes subirlos bastante más (ver tabla de sizing en el README).
PHP_FPM_PM=dynamic
PHP_FPM_PM_MAX_CHILDREN=8
PHP_FPM_PM_START_SERVERS=2
PHP_FPM_PM_MIN_SPARE_SERVERS=2
PHP_FPM_PM_MAX_SPARE_SERVERS=4

# --- zabbix-agent2 (automonitorización del propio stack) ---
ZABBIX_AGENT_MEM_LIMIT=96m

# --- Personalización avanzada ---
# Para tuning fino de zabbix_server.conf (pollers, caches, housekeeping...), php.ini y
# zabbix_agent2.conf más allá de lo de arriba, no hace falta tocar este .env ni el compose:
# copia las plantillas de env_vars/*.env.example a env_vars/*.env (no se commitean) y
# descomenta lo que necesites. Ver sección "Personalización avanzada" en el README.
